{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "echo session started"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "echo prompt"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "./block-rm.sh"}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "./lint.sh"}]},
      {"matcher": "Write", "hooks": [{"type": "mcp_tool", "server": "localdb", "tool": "scan"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "echo done"}]}
    ]
  }
}
